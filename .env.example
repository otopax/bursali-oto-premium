# ==========================================
# Bursalı Oto Dijital Sistemi - V5.0
# Environment Variables Template
# ==========================================

# 1. Database
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/bursali_oto?schema=public"

# 2. Redis & BullMQ
# Redis connection URL for queues, idempotency, and distributed locking
REDIS_URL="redis://localhost:6379"

# 3. AI & LLM Providers
# Gemini API Key for semantic search, vector embeddings, and chatbot
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 4. NextAuth / Security
# Secret for signing session cookies (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# 5. External Services (ERP/OEM Connectors)
# Example placeholders for future ERP/OEM integrations
# TEC_DOC_API_KEY=""
# SAP_CONNECTOR_URL=""

# 6. Analytics
# Google Analytics 4 Measurement ID (public — client-side)
NEXT_PUBLIC_GA_ID=""

# 6b. Sentry (Hata İzleme) — DSN yoksa Sentry init olmaz, no-op çalışır
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Aşağıdakiler sadece source map upload için (opsiyonel)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# 7. Public Site URL (sitemap.js için)
NEXT_PUBLIC_SITE_URL="https://bursaliotoservis.com"

# 8. Data Provider (json | postgres) — Blue-Green DAL geçişi için
DATA_PROVIDER="postgres"

# 9. Redis (opsiyonel — REDIS_URL yerine ayrı host/port)
# REDIS_HOST="127.0.0.1"
# REDIS_PORT="6379"

# 10. Veritabanı Yedekleme (R1) — scripts/backup-db.js
# Yerel yedek klasörü ve rotasyon süresi (gün). Harici kopya için rclone remote.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="7"
# rclone hedefi — Drive/S3/R2 hepsi desteklenir; boşsa sadece yerel yedek alınır
# BACKUP_RCLONE_REMOTE="gdrive:bursali-yedek"

# 11. Google İşletme Profili yorum linki (Faz 1.4)
# GBP panelinden "Yorum iste" kısa linkini alın (g.page/r/... ile başlar). İş emri
# tamamlanınca müşteriye WhatsApp yorum isteme mesajına eklenir. Boşsa mesaj linksiz gönderilir.
NEXT_PUBLIC_GBP_REVIEW_URL=https://g.page/r/XXXXXXXX/review
